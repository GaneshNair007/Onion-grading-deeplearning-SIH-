# ONION-Q environment template — copy to .env and fill locally.
# NEVER commit the real .env (it is git-ignored). No real secret belongs here.

# --- runtime mode ---
ONIONQ_MODE=demo                 # demo | production
ONIONQ_DEMO_BANNER=true          # show "DEMO DATA" markers in UI/reports

# --- backend ---
ONIONQ_DB_URL=sqlite:///backend/onionq.db
ONIONQ_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ONIONQ_API_PREFIX=/api/v1

# --- storage (paths are created if missing) ---
ONIONQ_STORAGE_DIR=backend/storage
ONIONQ_MAX_UPLOAD_MB=25

# --- models (leave empty to use models/registry.json) ---
ONIONQ_VISION_ARTIFACT=
ONIONQ_DETECTOR_ARTIFACT=
ONIONQ_ACOUSTIC_ARTIFACT=

# --- grading policy ---
ONIONQ_POLICY=demo_policy         # file stem inside config/grading/
ONIONQ_POLICY_REQUIRE_VERIFIED=false

# --- feature flags (experimental features stay off by default) ---
ONIONQ_ENABLE_ACOUSTIC_SCAN=false     # true only when a real-data model exists
ONIONQ_ENABLE_ANOMALY_DASHBOARD=true
ONIONQ_ENABLE_MULTILINGUAL_REPORT=false
ONIONQ_ENABLE_POLICY_SYNC=true

# --- optional report signing (server side only; never embed a private key in an app) ---
ONIONQ_SIGNING_KEY_PATH=
