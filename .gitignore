# ---- Secrets and credentials ----
.env
.env.*
# ...but the template MUST be committed: it documents the configuration
# contract. scripts/clean_clone_smoke_test.py --tracked-copy fails if this
# negation is lost (that is exactly how this line was found).
!.env.example
*.pem
*.key
*.secret

# ---- Python ----
__pycache__/
.venv/
venv/
*.pyc

# ---- Node ----
node_modules/

# ---- Build artifacts, runs, outputs ----
dist/
build/
runs/
outputs/
logs/
checkpoints/

# ---- Model weights / trained artifacts ----
*.pt
!backend/model_backend/best.pt
*.pth
*.onnx
*.h5
*.tflite
*.joblib

# ---- Test / tooling caches ----
.pytest_cache/
.test-tmp*/
.evaluation_scratch/

# ---- Local scratch (device offline-store data, ad-hoc runs) ----
local_data/

# OOD rejection reference is fitted from the license-unresolved
# onion-leaves-and-bulb source (background-only embedding use).
# Machine-local artifact: rebuild with scripts/build_rejection_reference.py
models/vision/rejection_reference.npz
.freebuff/

# ---- Generated work lists and exported artifacts ----
review-export/
models/onnx/
*.onnx

# ---- Generated inspection reports (regenerated by every demo run) ----
reports/

# ---- Local dataset originals (already partitioned into dataset/parts) ----
# The unpacked Roboflow downloads and their archives stay on the machine that
# produced the partitioned dataset; committing them would duplicate ~1.7 GB and
# exceed the GitHub per-file limit. See dataset/MANIFEST.csv for what IS stored.
*.coco-segmentation/
*.coco-mmdetection/
Onion\ Leaves\ and\ Bulb\ Dataset/
Onion*Dataset/
Onion*.zip
onions*.zip

# ---- Backups & Backend Artifacts ----
.legacy_backend_backup/
backend/reports/*.html
backend/reports/*.pdf
backend/reports/*.png
!backend/reports/.gitkeep

# ---- OS junk ----
.DS_Store
Thumbs.db

# ---- Frontend & Node ----
node_modules/
dist/
.env
.env.*
.freebuff/
